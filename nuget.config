<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <!--
        `clear` first, then nuget.org — exactly one source.

        This tree is self-contained (see AiGuides/10-Decisions.md ADR-0002). Without `clear`, a machine- or
        user-level feed could silently serve a different build of a package than the one the tests ran
        against, which makes every verification in AiGuides/09-Progress.md meaningless.
    -->
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    </packageSources>
</configuration>
