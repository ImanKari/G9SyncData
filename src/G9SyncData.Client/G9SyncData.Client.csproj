<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\build\G9SyncData.Library.props" />

  <PropertyGroup>
    <RootNamespace>G9SyncData.Client</RootNamespace>
    <Description>G9SyncData client engine for .NET MAUI and other clients: client model, prioritised run scheduler, global idempotent push, resumable stage-then-commit pull, hash-bucket reconciliation, deterministic progress with learned phase weights, change feed and health. NativeAOT-compatible; storage and transport are pluggable.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\G9SyncData.Abstractions\G9SyncData.Abstractions.csproj" />
    <ProjectReference Include="..\G9SyncData.Protocol\G9SyncData.Protocol.csproj" />
  </ItemGroup>

  <!-- The client model generator ships inside this package so consumers get it with no extra reference. -->
  <ItemGroup>
    <None Include="..\G9SyncData.SourceGenerators\bin\$(Configuration)\netstandard2.0\G9SyncData.SourceGenerators.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"
          Condition="Exists('..\G9SyncData.SourceGenerators\bin\$(Configuration)\netstandard2.0\G9SyncData.SourceGenerators.dll')" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="G9SyncData.Tests" />
    <InternalsVisibleTo Include="G9SyncData.IntegrationTests" />
  </ItemGroup>

</Project>
